# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Danh sách đầy đủ + luật kiểm tra: src/config/env.validation.ts

NODE_ENV=development
PORT=3000

# ===== Database (khớp docker-compose.yml ở thư mục gốc) =====
# Cloud (Vercel + Neon) dùng DATABASE_URL thay cho bộ DB_*.
# DATABASE_URL=postgres://user:pass@host/db
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lancare
DB_PASSWORD=lancare_dev_pw
DB_NAME=lancare_hub
DB_SSL=false

# ===== JWT (2 secret KHÁC nhau, mỗi cái >= 32 ký tự) =====
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

# BẮT BUỘC — 64 ký tự hex (32 byte), mã hoá SĐT/CCCD. Nhóm có key chung thì dùng key đó
# (khác key → không giải mã được dữ liệu cũ). Sinh mới: openssl rand -hex 32
DATA_ENCRYPTION_KEY=

# ===== Admin đầu tiên (npm run seed:admin) =====
SEED_ADMIN_EMAIL=admin@lancarehub.vn
SEED_ADMIN_PASSWORD=change-me-123

# URL web FE — dùng cho link trong mail và link video call.
APP_BASE_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002

# ===== Google Sign-In (POST /auth/google) =====
# Client ID OAuth (Google Cloud Console → Google Auth Platform → Clients).
# Nhiều client (web, android, ios) cách nhau dấu phẩy. Để trống → /auth/google trả 503.
GOOGLE_CLIENT_IDS=

# ===== SMTP — gửi mật khẩu cho tài khoản tạo bằng Google =====
# Để trống SMTP_HOST → không gửi mail (chỉ log). Có SMTP_HOST → bắt buộc SMTP_USER,
# SMTP_PASS, APP_BASE_URL. Gmail: SMTP_PASS là App Password (cần bật xác minh 2 bước).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ===== Dịch vụ ngoài =====
# BẮT BUỘC (video call GetStream). Chỉ test auth thì điền chuỗi bất kỳ.
STREAM_API_KEY=dev-stream-key
STREAM_API_SECRET=dev-stream-secret
# Upload ảnh. Không dùng thì để nguyên dòng comment (KHÔNG để `CLOUDINARY_URL=` rỗng).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
SEPAY_WEBHOOK_KEY=change-me-at-least-16-chars
FPTAI_API_KEY=
GOOGLE_MAPS_API_KEY=
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=
PLANTNET_API_KEY=
PLANTNET_PROJECT=all
PLANT_ID_API_KEY=

# Tài khoản nhận tiền in lên mã VietQR.
BANK_BIN=970422
BANK_ACCOUNT_NUMBER=0000000000
BANK_ACCOUNT_NAME=LANCARE HUB

# Chỉ đặt TRUST_PROXY=true khi có proxy đứng trước BE (nginx, Render...). Vercel tự bật.
# Chạy thẳng trên máy (local/demo) thì để nguyên comment — không thì client giả được IP.
# TRUST_PROXY=true

# Rate limit theo IP (100 req/phút; login/register 5, google 10, refresh 30).
# CHỈ e2e đặt THROTTLE_DISABLED=true; production cấm (app không khởi động).
# THROTTLE_DISABLED=false

# Bảo vệ /api/docs bằng Basic Auth. Local: để nguyên comment (KHÔNG để rỗng).
# SWAGGER_USER=admin
# SWAGGER_PASSWORD=change-me
