# ============================================================
# LanCare Hub BE — mẫu cấu hình môi trường
# Copy thành .env rồi tự điền các giá trị <...> theo hướng dẫn.
# TUYỆT ĐỐI không commit file .env thật / không gửi secret qua chat.
# ============================================================

# ===== App =====
NODE_ENV=development
PORT=3001
# TypeORM synchronize is automatically enabled only outside production.
# Production deployments must use reviewed migrations; DB_SYNC is intentionally ignored.

# ===== Database (PostgreSQL local của bạn) =====
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=lancare
DB_PASSWORD=<mật khẩu Postgres local của bạn>
DB_NAME=lancare_hub
# true khi dùng Postgres managed có SSL (Neon/production)
DB_SSL=false

# ===== JWT =====
# Tự sinh, mỗi máy một bộ: openssl rand -hex 32
JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=<openssl rand -hex 32>
JWT_REFRESH_EXPIRES=7d

# ===== bcrypt =====
BCRYPT_SALT_ROUNDS=12

# ===== Mã hóa cột AES-256-GCM =====
# 32 byte hex (64 ký tự): openssl rand -hex 32
# Lưu ý: đổi key này thì dữ liệu đã mã hoá trong DB local cũ sẽ không giải mã được.
DATA_ENCRYPTION_KEY=<openssl rand -hex 32>

# ===== Seed admin (npm run seed:admin) =====
SEED_ADMIN_EMAIL=admin@lancarehub.vn
SEED_ADMIN_PASSWORD=<tự đặt, chỉ dùng local>

# ===== Stream (video call — tạm, module của teammate) =====
STREAM_API_KEY=dummy
STREAM_API_SECRET=dummy

# ===== Webhook SePay =====
# Test LOGIC thanh toán ở local: KHÔNG cần tài khoản SePay thật.
#   1. Đặt key bất kỳ ở dòng dưới (ví dụ: doan-doi-abc-123, tối thiểu 16 ký tự).
#   2. Tự giả SePay bằng curl vào POST /api/v1/webhooks/sepay
#      với header:  Authorization: Apikey <key bạn vừa đặt>
#      (payload mẫu xem Swagger /api/docs hoặc hỏi người phụ trách payments).
#
# Test END-TO-END với tiền thật (tuỳ chọn, dùng ngân hàng CỦA CHÍNH BẠN):
#   1. Đăng ký sepay.vn (có gói miễn phí) → liên kết tài khoản ngân hàng của bạn.
#   2. Máy local không nhận được webhook trực tiếp → mở tunnel:
#        ngrok http 3001
#      rồi vào SePay dashboard → Webhooks → tạo webhook trỏ về:
#        https://<url-ngrok>/api/v1/webhooks/sepay
#      chọn kiểu xác thực Api Key. (ngrok free đổi URL mỗi lần chạy → nhớ cập nhật lại.)
#   3. Chép API key từ SePay dashboard vào dòng dưới.
#   4. Điền BANK_* bên dưới bằng đúng tài khoản ngân hàng bạn đã liên kết SePay —
#      QR sinh ra sẽ trỏ tiền vào tài khoản CỦA BẠN, chuyển thử vài nghìn đồng
#      từ tài khoản khác của chính bạn là chạy đủ luồng: bank → SePay → webhook → PAID.
SEPAY_WEBHOOK_KEY=<key SePay của bạn, hoặc chuỗi tự đặt nếu chỉ test local>

# ===== CORS (FE dev, comma separated for multiple allowed origins) =====
# Frontend runs on 3002 and calls this backend on 3001/api/v1.
CORS_ORIGIN=http://localhost:3002

# Public origin used only to create a video-call join URL.
APP_BASE_URL=http://localhost:3002

# ===== Google Distance Matrix (để trống → dùng fallback Haversine) =====
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://localhost:5000
# Chỉ cần khi ROUTING_PROVIDER=google.
GOOGLE_MAPS_API_KEY=

# ===== Tài khoản nhận tiền (SePay theo dõi) — của CHÍNH BẠN =====
# BANK_BIN tra tại https://api.vietqr.io/v2/banks (MB=970422, ACB=970416, ...)
BANK_BIN=<BIN ngân hàng của bạn>
BANK_ACCOUNT_NUMBER=<số tài khoản của bạn>
BANK_ACCOUNT_NAME=<TEN KHONG DAU>
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
